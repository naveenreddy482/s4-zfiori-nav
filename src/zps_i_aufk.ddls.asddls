@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'View for Order Master Data'
define view entity ZPS_I_AUFK
  as select from aufk
{
  key aufnr                     as OrderID,
      auart                     as OrderType,
      autyp                     as OrderCategory,
      refnr                     as ReferenceOrderID,
      ernam                     as CreatedByUser,
      erdat                     as CreatedOnDate,
      aenam                     as ChangedByUser,
      aedat                     as ChangedOnDate,
      ktext                     as OrderShortDescription,
      ltext                     as OrderLongDescription,
      bukrs                     as CompanyCode,
      werks                     as Plant,
      gsber                     as BusinessArea,
      kokrs                     as ControllingArea,
      cckey                     as CostCollectorKey,
      kostv                     as ResponsibleCostCenter,
      stort                     as Location,
      sowrk                     as ProductionPlant,
      astkz                     as InvestmentIndicator,
      waers                     as Currency,
      astnr                     as InvestmentNumber,
      stdat                     as StartDate,
      estnr                     as InvestmentMeasure,
      phas0                     as Phase0Status,
      phas1                     as Phase1Status,
      phas2                     as Phase2Status,
      phas3                     as Phase3Status,
      pdat1                     as PlannedDatePhase1,
      pdat2                     as PlannedDatePhase2,
      pdat3                     as PlannedDatePhase3,
      idat1                     as ActualDatePhase1,
      idat2                     as ActualDatePhase2,
      idat3                     as ActualDatePhase3,
      objid                     as InternalObjectID,
      vogrp                     as ResponsiblePlannerGroup,
      loekz                     as DeletionFlag,
      plgkz                     as PlanningIndicator,
      kvewe                     as UsageCheck,
      kappl                     as Application,
      kalsm                     as CalculationSchema,
      zschl                     as PaymentTerms,
      abkrs                     as PayrollArea,
      kstar                     as CostElement,
      kostl                     as CostCenter,
      saknr                     as GLEntryAccount,
      setnm                     as SetName,
      cycle                     as CycleID,
      sdate                     as StartDateCycle,
      seqnr                     as SequenceNumber,
      user0                     as UserField0,
      user1                     as UserField1,
      user2                     as UserField2,
      user3                     as UserField3,
      user4                     as UserField4,
      user5                     as UserField5,
      user6                     as UserField6,
      user7                     as UserField7,
      user8                     as UserField8,
      user9                     as UserField9,
      objnr                     as ControllingObject,
      prctr                     as ProfitCenter,
      pspel                     as WBSElementInternalID,
      awsls                     as SalesGroup,
      abgsl                     as CompletionIndicator,
      eb_post                   as PostingIndicator,
      txjcd                     as TaxJurisdiction,
      func_area                 as FunctionalArea,
      scope                     as ScopeIndicator,
      plint                     as PlanningIntegration,
      kdauf                     as SalesOrder,
      kdpos                     as SalesOrderItem,
      aufex                     as ExternalOrderID,
      ivpro                     as InvoiceProfile,
      logsystem                 as LogicalSystem,
      flg_mltps                 as MultipleProjectsFlag,
      abukr                     as CoCodeForAcctAssignment,
      akstl                     as RequestingCostCenter,
      sizecl                    as SizeClass,
      izwek                     as PlantSection,
      umwkz                     as ConversionUnit,
      kstempf                   as ReceivingCostCenter,
      zschm                     as SpecialProcessingIndicator,
      pkosa                     as PrimaryCostActivityType,
      anfaufnr                  as RequestOrderNumber,
      procnr                    as ProcessOrderNumber,
      proty                     as ProcessType,
      rsord                     as ResourceOrder,
      bemot                     as ReasonForOrder,
      adrnra                    as AddressID,
      erfzeit                   as CreatedAtTime,
      aezeit                    as ChangedAtTime,
      cstg_vrnt                 as CostingVariant,
      costestnr                 as CostEstimateNumber,
      veraa_user                as PersonResponsible,
      eew_aufk_ps_dummy         as EewAufkPsDummy,
      vname                     as Vname,
      recid                     as Recid,
      etype                     as Etype,
      otype                     as Otype,
      jv_jibcl                  as JvJibcl,
      jv_jibsa                  as JvJibsa,
      jv_oco                    as JvOco,
      cpd_updat                 as CpdUpdat,
      /cum/indcu                as CumIndcu,
      /cum/cmnum                as CumCmnum,
      /cum/auest                as CumAuest,
      /cum/desnum               as CumDesnum,
      ad01profnr                as Ad01profnr,
      vaplz                     as Vaplz,
      wawrk                     as Wawrk,
      ferc_ind                  as FercInd,
      claim_control             as ClaimControl,
      update_needed             as UpdateNeeded,
      update_control            as UpdateControl
}
